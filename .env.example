# Client-accessible Supabase variables (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NOTE: Do NOT place LLM API keys or Supabase Service Role Key here!
# Those exist ONLY as Supabase Edge Function secrets (via `supabase secrets set`).
